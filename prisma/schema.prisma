// AMS – Datenmodell
// Mandantenfähig: Jedes Unternehmen (Organization) ist ein Mandant.
// Fachdaten späterer Module tragen immer eine organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Rolle einer Person innerhalb eines Unternehmens
enum Role {
  /// Verwaltet Nutzer, Standorte, Stammdaten des Unternehmens
  ORG_ADMIN
  /// Fachkraft für Arbeitssicherheit (intern oder extern)
  SAFETY_OFFICER
  /// Führungskraft
  MANAGER
  /// Prüfer/in (befähigte Person, auch extern)
  INSPECTOR
  /// Mitarbeitende: melden, lesen, Unterweisungen absolvieren
  EMPLOYEE
}

/// Unternehmen = Mandant
model Organization {
  id          String       @id @default(cuid())
  name        String
  /// Kurzname für URLs und Anzeige, eindeutig
  slug        String       @unique
  active      Boolean      @default(true)
  memberships Membership[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  sites       Site[]
  departments Department[]
  employees   Employee[]
  equipment   Equipment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  /// null, solange die Einladung nicht angenommen wurde
  passwordHash    String?
  /// Betreiber der Plattform: legt Unternehmen an
  isPlatformAdmin Boolean      @default(false)
  active          Boolean      @default(true)
  lastLoginAt     DateTime?
  memberships     Membership[]
  sessions        Session[]
  passwordResets  PasswordReset[]
  invitationsSent Invitation[] @relation("InvitedBy")
  auditLogs       AuditLog[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

/// Zugehörigkeit einer Person zu einem Unternehmen mit Rolle.
/// Eine externe Sifa hat mehrere Memberships.
model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  /// Externe Person (z. B. externe Sifa, externer Prüfer)
  external       Boolean      @default(false)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// Einladung per Link (auch für Passwort-Zurücksetzen genutzt)
model Invitation {
  id             String       @id @default(cuid())
  email          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  external       Boolean      @default(false)
  /// SHA-256 des Tokens – das Token selbst wird nie gespeichert
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String?
  invitedBy      User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Session {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 des Cookie-Tokens
  tokenHash            String   @unique
  /// aktuell gewähltes Unternehmen (Umschalter)
  activeOrganizationId String?
  expiresAt            DateTime
  createdAt            DateTime @default(now())

  @@index([userId])
}

/// Änderungsprotokoll: wer hat was wann geändert
model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entity         String
  entityId       String?
  details        Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
}

/// Link zum Setzen eines neuen Passworts (vom Admin erzeugt)
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ───────────── Phase 2: Stammdaten, Anlagen, Prüfungen ─────────────

model Site {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  active         Boolean      @default(true)
  departments    Department[]
  employees      Employee[]
  equipment      Equipment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  name           String
  active         Boolean      @default(true)
  employees      Employee[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
}

/// Mitarbeiterstamm – auch Personen ohne Login (für Unterweisungen, Qualifikationen, Verantwortung)
model Employee {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personnelNumber      String?
  firstName            String
  lastName             String
  jobTitle             String?
  siteId               String?
  site                 Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  departmentId         String?
  department           Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  /// Auszubildende/r (JArbSchG, halbjährliche Unterweisung)
  apprentice           Boolean      @default(false)
  entryDate            DateTime?
  exitDate             DateTime?
  active               Boolean      @default(true)
  responsibleEquipment Equipment[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([organizationId, personnelNumber])
  @@index([organizationId, lastName])
}

enum EquipmentStatus {
  ACTIVE
  LOCKED
  REPAIR
  DECOMMISSIONED
  SCRAPPED
}

/// Anlage, Maschine oder Arbeitsmittel
model Equipment {
  id                  String                @id @default(cuid())
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryNumber     String
  name                String
  category            String
  manufacturer        String?
  model               String?
  serialNumber        String?
  yearBuilt           Int?
  ceMarked            Boolean               @default(false)
  hasDeclarationOfConformity Boolean        @default(false)
  hasOperatingManual  Boolean               @default(false)
  commissionedAt      DateTime?
  siteId              String?
  site                Site?                 @relation(fields: [siteId], references: [id], onDelete: SetNull)
  location            String?
  responsibleId       String?
  responsible         Employee?             @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  status              EquipmentStatus       @default(ACTIVE)
  notes               String?
  obligations         InspectionObligation[]
  statusChanges       EquipmentStatusChange[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([organizationId, inventoryNumber])
  @@index([organizationId, status])
}

model EquipmentStatusChange {
  id          String          @id @default(cuid())
  equipmentId String
  equipment   Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  from        EquipmentStatus
  to          EquipmentStatus
  reason      String?
  userId      String?
  createdAt   DateTime        @default(now())
}

enum InspectorType {
  /// zur Prüfung befähigte Person (intern)
  COMPETENT_PERSON
  /// externer Dienstleister
  EXTERNAL
  /// Zugelassene Überwachungsstelle
  ZUS
  /// Sachverständige/r
  EXPERT
}

/// Prüfpflicht – eine Anlage kann mehrere haben (z. B. E-Prüfung + UVV + ZÜS)
model InspectionObligation {
  id              String        @id @default(cuid())
  organizationId  String
  equipmentId     String
  equipment       Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  title           String
  legalBasis      String?
  intervalMonths  Int
  inspectorType   InspectorType @default(COMPETENT_PERSON)
  lastInspectedAt DateTime?
  nextDueAt       DateTime
  active          Boolean       @default(true)
  inspections     Inspection[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId, nextDueAt])
}

enum InspectionResult {
  /// ohne Mängel
  PASSED
  /// Mängel, Weiterbetrieb zulässig
  DEFECTS
  /// nicht bestanden – Anlage wird gesperrt
  FAILED
}

model Inspection {
  id            String               @id @default(cuid())
  obligationId  String
  obligation    InspectionObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  performedAt   DateTime
  inspectorName String
  result        InspectionResult
  notes         String?
  nextDueAt     DateTime
  userId        String?
  createdAt     DateTime             @default(now())
}
