// AMS – Datenmodell
// Mandantenfähig: Jedes Unternehmen (Organization) ist ein Mandant.
// Fachdaten späterer Module tragen immer eine organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Rolle einer Person innerhalb eines Unternehmens
enum Role {
  /// Verwaltet Nutzer, Standorte, Stammdaten des Unternehmens
  ORG_ADMIN
  /// Fachkraft für Arbeitssicherheit (intern oder extern)
  SAFETY_OFFICER
  /// Führungskraft
  MANAGER
  /// Prüfer/in (befähigte Person, auch extern)
  INSPECTOR
  /// Mitarbeitende: melden, lesen, Unterweisungen absolvieren
  EMPLOYEE
}

/// Unternehmen = Mandant
model Organization {
  id                 String                 @id @default(cuid())
  name               String
  /// Kurzname für URLs und Anzeige, eindeutig
  slug               String                 @unique
  active             Boolean                @default(true)
  memberships        Membership[]
  invitations        Invitation[]
  auditLogs          AuditLog[]
  sites              Site[]
  departments        Department[]
  employees          Employee[]
  equipment          Equipment[]
  substances         HazardousSubstance[]
  instructions       OperatingInstruction[]
  trainingTopics     TrainingTopic[]
  qualificationTypes QualificationType[]
  incidents          Incident[]
  firstAidEntries    FirstAidEntry[]
  actions            Action[]
  riskAssessments    RiskAssessment[]
  checklistTemplates ChecklistTemplate[]
  walkthroughs       Walkthrough[]
  ppeItems           PpeItem[]
  appointments       Appointment[]
  asaMeetings        AsaMeeting[]
  timeEntries        TimeEntry[]
  medicalCheckTypes  MedicalCheckType[]
  contractors        Contractor[]
  permits            Permit[]
  legalRequirements  LegalRequirement[]
  attachments        Attachment[]
  emergencyPlans     EmergencyPlan[]
  drills             Drill[]
  ssoConfig          SsoConfig?
  /// Soll-Einsatzzeit der Sifa in Stunden pro Jahr (DGUV Vorschrift 2)
  sifaHoursTarget    Int?
  /// Ersthelferquote in Prozent (DGUV V1 § 26: 5 % Verwaltung/Handel, 10 % sonstige Betriebe)
  firstAidRate       Int                    @default(10)
  /// Brandschutzhelferquote in Prozent (ASR A2.2: in der Regel 5 %)
  fireWardenRate     Int                    @default(5)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  name            String
  /// null, solange die Einladung nicht angenommen wurde
  passwordHash    String?
  /// Betreiber der Plattform: legt Unternehmen an
  isPlatformAdmin Boolean         @default(false)
  active          Boolean         @default(true)
  lastLoginAt     DateTime?
  memberships     Membership[]
  sessions        Session[]
  passwordResets  PasswordReset[]
  invitationsSent Invitation[]    @relation("InvitedBy")
  auditLogs       AuditLog[]
  /// TOTP-Geheimnis (Base32) für Zwei-Faktor-Anmeldung
  totpSecret      String?
  totpEnabled     Boolean      @default(false)
  /// tägliche/wöchentliche Fristen-E-Mail
  emailDigest     Boolean      @default(true)
  timeEntries     TimeEntry[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

/// Zugehörigkeit einer Person zu einem Unternehmen mit Rolle.
/// Eine externe Sifa hat mehrere Memberships.
model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  /// Externe Person (z. B. externe Sifa, externer Prüfer)
  external       Boolean      @default(false)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// Einladung per Link (auch für Passwort-Zurücksetzen genutzt)
model Invitation {
  id             String       @id @default(cuid())
  email          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  external       Boolean      @default(false)
  /// SHA-256 des Tokens – das Token selbst wird nie gespeichert
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String?
  invitedBy      User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Session {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 des Cookie-Tokens
  tokenHash            String   @unique
  /// aktuell gewähltes Unternehmen (Umschalter)
  activeOrganizationId String?
  expiresAt            DateTime
  createdAt            DateTime @default(now())

  @@index([userId])
}

/// Änderungsprotokoll: wer hat was wann geändert
model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entity         String
  entityId       String?
  details        Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
}

/// Link zum Setzen eines neuen Passworts (vom Admin erzeugt)
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ───────────── Phase 2: Stammdaten, Anlagen, Prüfungen ─────────────

model Site {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  address         String?
  active          Boolean         @default(true)
  departments     Department[]
  employees       Employee[]
  equipment       Equipment[]
  incidents       Incident[]
  firstAidEntries FirstAidEntry[]
  riskAssessments RiskAssessment[]
  walkthroughs   Walkthrough[]
  appointments   Appointment[]
  permits        Permit[]
  emergencyPlan  EmergencyPlan?
  drills         Drill[]
  substanceUses   SubstanceUse[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([organizationId, name])
}

model Department {
  id                   String                @id @default(cuid())
  organizationId       String
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId               String?
  site                 Site?                 @relation(fields: [siteId], references: [id], onDelete: SetNull)
  name                 String
  active               Boolean               @default(true)
  employees            Employee[]
  riskAssessments RiskAssessment[]
  medicalRequirements MedicalRequirement[]
  trainingRequirements TrainingRequirement[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([organizationId, name])
}

/// Mitarbeiterstamm – auch Personen ohne Login (für Unterweisungen, Qualifikationen, Verantwortung)
model Employee {
  id                   String           @id @default(cuid())
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personnelNumber      String?
  firstName            String
  lastName             String
  jobTitle             String?
  siteId               String?
  site                 Site?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  departmentId         String?
  department           Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  /// Auszubildende/r (JArbSchG, halbjährliche Unterweisung)
  apprentice           Boolean          @default(false)
  entryDate            DateTime?
  exitDate             DateTime?
  active               Boolean          @default(true)
  responsibleEquipment Equipment[]
  trainingRecords      TrainingRecord[]
  incidents            Incident[]
  firstAidEntries      FirstAidEntry[]
  responsibleActions   Action[]
  riskAssessments      RiskAssessment[]
  ppeIssues            PpeIssue[]
  appointments         Appointment[]
  medicalRecords       MedicalRecord[]
  legalRequirements    LegalRequirement[]
  qualifications       Qualification[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([organizationId, personnelNumber])
  @@index([organizationId, lastName])
}

enum EquipmentStatus {
  ACTIVE
  LOCKED
  REPAIR
  DECOMMISSIONED
  SCRAPPED
}

/// Anlage, Maschine oder Arbeitsmittel
model Equipment {
  id                         String                  @id @default(cuid())
  organizationId             String
  organization               Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryNumber            String
  name                       String
  category                   String
  manufacturer               String?
  model                      String?
  serialNumber               String?
  yearBuilt                  Int?
  ceMarked                   Boolean                 @default(false)
  hasDeclarationOfConformity Boolean                 @default(false)
  hasOperatingManual         Boolean                 @default(false)
  commissionedAt             DateTime?
  siteId                     String?
  site                       Site?                   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  location                   String?
  responsibleId              String?
  responsible                Employee?               @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  status                     EquipmentStatus         @default(ACTIVE)
  notes                      String?
  obligations                InspectionObligation[]
  statusChanges              EquipmentStatusChange[]
  instructions               OperatingInstruction[]
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@unique([organizationId, inventoryNumber])
  @@index([organizationId, status])
}

model EquipmentStatusChange {
  id          String          @id @default(cuid())
  equipmentId String
  equipment   Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  from        EquipmentStatus
  to          EquipmentStatus
  reason      String?
  userId      String?
  createdAt   DateTime        @default(now())
}

enum InspectorType {
  /// zur Prüfung befähigte Person (intern)
  COMPETENT_PERSON
  /// externer Dienstleister
  EXTERNAL
  /// Zugelassene Überwachungsstelle
  ZUS
  /// Sachverständige/r
  EXPERT
}

/// Prüfpflicht – eine Anlage kann mehrere haben (z. B. E-Prüfung + UVV + ZÜS)
model InspectionObligation {
  id              String        @id @default(cuid())
  organizationId  String
  equipmentId     String
  equipment       Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  title           String
  legalBasis      String?
  intervalMonths  Int
  inspectorType   InspectorType @default(COMPETENT_PERSON)
  lastInspectedAt DateTime?
  nextDueAt       DateTime
  active          Boolean       @default(true)
  inspections     Inspection[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId, nextDueAt])
}

enum InspectionResult {
  /// ohne Mängel
  PASSED
  /// Mängel, Weiterbetrieb zulässig
  DEFECTS
  /// nicht bestanden – Anlage wird gesperrt
  FAILED
}

model Inspection {
  id            String               @id @default(cuid())
  obligationId  String
  obligation    InspectionObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  performedAt   DateTime
  inspectorName String
  result        InspectionResult
  notes         String?
  nextDueAt     DateTime
  userId        String?
  createdAt     DateTime             @default(now())
}

// ───────────── Phase 3: Gefahrstoffe und Betriebsanweisungen ─────────────

enum SubstanceStatus {
  /// beantragt, Prüfung durch die Sifa ausstehend
  REQUESTED
  APPROVED
  REJECTED
  /// nicht mehr im Einsatz (bleibt im Verzeichnis dokumentiert)
  PHASED_OUT
}

enum SignalWord {
  DANGER
  WARNING
  NONE
}

/// Gefahrstoffverzeichnis nach § 6 Abs. 12 GefStoffV
model HazardousSubstance {
  id                  String                 @id @default(cuid())
  organizationId      String
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Handelsname / Produktbezeichnung
  name                String
  manufacturer        String?
  casNumber           String?
  /// Verwendungszweck / Tätigkeit
  usage               String?
  /// GHS01 … GHS09
  pictograms          String[]
  signalWord          SignalWord             @default(NONE)
  hStatements         String[]
  pStatements         String[]
  /// Lagerklasse nach TRGS 510, z. B. "3", "6.1A", "8B"
  storageClass        String?
  /// Wassergefährdungsklasse: "1", "2", "3", "nwg"
  waterHazardClass    String?
  /// Datum des Sicherheitsdatenblatts
  sdsDate             DateTime?
  /// nächste Überprüfung auf Aktualität des SDB
  sdsReviewDue        DateTime?
  ppe                 String?
  substitutionChecked Boolean                @default(false)
  substitutionNotes   String?
  status              SubstanceStatus        @default(REQUESTED)
  requestedById       String?
  decidedById         String?
  decidedAt           DateTime?
  decisionNote        String?
  uses                SubstanceUse[]
  instructions        OperatingInstruction[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([organizationId, status])
}

/// Einsatzort und Menge eines Gefahrstoffs
model SubstanceUse {
  id          String             @id @default(cuid())
  substanceId String
  substance   HazardousSubstance @relation(fields: [substanceId], references: [id], onDelete: Cascade)
  siteId      String?
  site        Site?              @relation(fields: [siteId], references: [id], onDelete: SetNull)
  workArea    String
  /// maximale Menge vor Ort
  quantity    Float?
  unit        String?
  createdAt   DateTime           @default(now())
}

enum InstructionType {
  /// Gefahrstoff (§ 14 GefStoffV, TRGS 555)
  HAZARDOUS_SUBSTANCE
  /// Maschine / Arbeitsmittel (§ 12 BetrSichV)
  MACHINE
  /// Tätigkeit / Arbeitsverfahren
  ACTIVITY
  /// Biostoffe (§ 14 BioStoffV)
  BIOLOGICAL
  /// Persönliche Schutzausrüstung (PSA-BV)
  PPE
}

enum InstructionStatus {
  DRAFT
  /// zur Freigabe vorgelegt
  IN_REVIEW
  RELEASED
  /// durch neuere Version abgelöst oder zurückgezogen
  ARCHIVED
}

/// Betriebsanweisung. Jede Version ist ein eigener Datensatz; seriesId verbindet die Versionen.
model OperatingInstruction {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  seriesId           String
  version            Int                 @default(1)
  type               InstructionType
  title              String
  /// Geltungsbereich: Arbeitsplatz, Tätigkeit, Arbeitsbereich
  scope              String?
  hazards            String              @default("")
  protectiveMeasures String              @default("")
  malfunctions       String              @default("")
  firstAid           String              @default("")
  maintenance        String              @default("")
  /// GHS- und ISO-7010-Codes, z. B. GHS02, M004, W001, P003, E003
  pictograms         String[]
  emergencyPhone     String?
  /// Aushangorte
  postings           String?
  status             InstructionStatus   @default(DRAFT)
  authorId           String?
  lastEditorId       String?
  releasedById       String?
  releasedAt         DateTime?
  reviewDue          DateTime?
  substanceId        String?
  substance          HazardousSubstance? @relation(fields: [substanceId], references: [id], onDelete: SetNull)
  equipmentId        String?
  equipment          Equipment?          @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  trainingTopics     TrainingTopic[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([seriesId, version])
  @@index([organizationId, status])
}

// ───────────── Phase 4: Schulungen, Unterweisungen, Qualifikationen ─────────────

enum TrainingKind {
  /// Unterweisung (§ 12 ArbSchG, § 4 DGUV V1)
  INSTRUCTION
  /// Schulung / Lehrgang
  COURSE
}

model TrainingTopic {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  kind           TrainingKind          @default(INSTRUCTION)
  description    String?
  /// Unterweisungsinhalt
  content        String                @default("")
  legalBasis     String?
  /// Wiederholung in Monaten, 0 = einmalig
  intervalMonths Int                   @default(12)
  /// Erstunterweisung vor Aufnahme der Tätigkeit erforderlich
  beforeStart    Boolean               @default(true)
  instructionId  String?
  instruction    OperatingInstruction? @relation(fields: [instructionId], references: [id], onDelete: SetNull)
  active         Boolean               @default(true)
  requirements   TrainingRequirement[]
  sessions       TrainingSession[]
  records        TrainingRecord[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([organizationId])
}

/// Wer braucht das Thema? Abteilung = null bedeutet: alle Beschäftigten
model TrainingRequirement {
  id              String        @id @default(cuid())
  topicId         String
  topic           TrainingTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department?   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// nur Auszubildende/Jugendliche
  apprenticesOnly Boolean       @default(false)

  @@unique([topicId, departmentId, apprenticesOnly])
}

model TrainingSession {
  id        String           @id @default(cuid())
  topicId   String
  topic     TrainingTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  date      DateTime
  trainer   String
  location  String?
  notes     String?
  userId    String?
  records   TrainingRecord[]
  createdAt DateTime         @default(now())
}

model TrainingRecord {
  id          String           @id @default(cuid())
  topicId     String
  topic       TrainingTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  completedAt DateTime
  /// null = unbegrenzt gültig
  validUntil  DateTime?
  createdAt   DateTime         @default(now())

  @@index([employeeId, topicId])
}

enum QualificationCategory {
  FIRST_AID
  FIRE_WARDEN
  OTHER
}

model QualificationType {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       QualificationCategory @default(OTHER)
  /// Gültigkeit in Monaten, null = unbegrenzt
  validityMonths Int?
  legalBasis     String?
  qualifications Qualification[]

  @@unique([organizationId, name])
}

model Qualification {
  id         String            @id @default(cuid())
  typeId     String
  type       QualificationType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  acquiredAt DateTime
  validUntil DateTime?
  issuer     String?
  notes      String?
  createdAt  DateTime          @default(now())

  @@index([employeeId])
}

// ───────────── Phase 5: Unfälle, Verbandbuch, Maßnahmen ─────────────

enum IncidentType {
  /// Arbeitsunfall
  ACCIDENT
  /// Wegeunfall
  COMMUTING
  /// Beinaheunfall
  NEAR_MISS
  /// unsicherer Zustand / unsichere Handlung
  UNSAFE_CONDITION
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  CLOSED
}

enum CauseCategory {
  TECHNICAL
  ORGANIZATIONAL
  PERSONAL
}

model Incident {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// laufende Nummer je Unternehmen und Jahr, z. B. 2026-007
  number          String
  type            IncidentType
  occurredAt      DateTime
  siteId          String?
  site            Site?          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  location        String?
  employeeId      String?
  employee        Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  /// falls nicht im Mitarbeiterstamm (z. B. Fremdfirma, Besucher)
  personName      String?
  activity        String?
  description     String
  injury          String?
  bodyPart        String?
  witnesses       String?
  firstAider      String?
  doctorVisit     Boolean        @default(false)
  /// Arbeitsunfähigkeit (Kalendertage, ohne Unfalltag)
  lostDays        Int            @default(0)
  fatal           Boolean        @default(false)
  /// Unfallanzeige erstattet am
  reportedToBgAt  DateTime?
  causeCategory   CauseCategory?
  rootCause       String?
  status          IncidentStatus @default(OPEN)
  reporterId      String?
  firstAidEntryId String?        @unique
  firstAidEntry   FirstAidEntry? @relation(fields: [firstAidEntryId], references: [id], onDelete: SetNull)
  actions         Action[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, occurredAt])
}

/// Verbandbuch (DGUV Vorschrift 1 § 24 Abs. 6) – Aufbewahrung 5 Jahre
model FirstAidEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  occurredAt     DateTime
  siteId         String?
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  location       String?
  employeeId     String?
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  personName     String?
  description    String
  injury         String
  measures       String
  firstAider     String
  witnesses      String?
  reporterId     String?
  incident       Incident?
  createdAt      DateTime     @default(now())

  @@index([organizationId, occurredAt])
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  /// Wirksamkeit geprüft
  VERIFIED
  CANCELLED
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
}

/// Maßnahmenart nach STOP-Prinzip
enum ActionLevel {
  SUBSTITUTION
  TECHNICAL
  ORGANIZATIONAL
  PERSONAL
}

/// Zentrale Maßnahme – Quelle: Unfall, Begehung, Gefährdungsbeurteilung, Prüfung …
model Action {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  level             ActionLevel?
  priority          ActionPriority @default(MEDIUM)
  responsibleId     String?
  responsible       Employee?      @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  dueDate           DateTime
  status            ActionStatus   @default(OPEN)
  completedAt       DateTime?
  effectivenessNote String?
  verifiedAt        DateTime?
  /// Herkunft für Anzeige und Link, z. B. "INCIDENT"
  sourceType        String         @default("OTHER")
  incidentId        String?
  incident          Incident?      @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  riskAssessmentId  String?
  riskAssessment    RiskAssessment? @relation(fields: [riskAssessmentId], references: [id], onDelete: SetNull)
  hazardId          String?
  hazard            Hazard?         @relation(fields: [hazardId], references: [id], onDelete: SetNull)
  walkthroughId     String?
  walkthrough       Walkthrough?    @relation(fields: [walkthroughId], references: [id], onDelete: SetNull)
  asaMeetingId      String?
  asaMeeting        AsaMeeting?     @relation(fields: [asaMeetingId], references: [id], onDelete: SetNull)
  legalRequirementId String?
  legalRequirement   LegalRequirement? @relation(fields: [legalRequirementId], references: [id], onDelete: SetNull)
  drillId            String?
  drill              Drill?          @relation(fields: [drillId], references: [id], onDelete: SetNull)
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([organizationId, status, dueDate])
}

// ───────────── Phase 6: Gefährdungsbeurteilung, Begehungen, PSA, Beauftragte ─────────────

enum RiskAssessmentKind {
  /// Arbeitsplatz / Tätigkeit
  GENERAL
  /// psychische Belastung (§ 5 Abs. 3 Nr. 6 ArbSchG)
  PSYCHOLOGICAL
  /// Mutterschutz (§ 10 MuSchG)
  MATERNITY
}

enum RiskAssessmentStatus {
  DRAFT
  RELEASED
  ARCHIVED
}

/// Gefährdungsbeurteilung (§§ 5, 6 ArbSchG)
model RiskAssessment {
  id                   String               @id @default(cuid())
  organizationId       String
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title                String
  kind                 RiskAssessmentKind   @default(GENERAL)
  siteId               String?
  site                 Site?                @relation(fields: [siteId], references: [id], onDelete: SetNull)
  departmentId         String?
  department           Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  /// Arbeitsplatz / Tätigkeit
  scope                String?
  participants         String?
  responsibleId        String?
  responsible          Employee?            @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  reviewIntervalMonths Int                  @default(24)
  status               RiskAssessmentStatus @default(DRAFT)
  releasedAt           DateTime?
  releasedById         String?
  reviewDue            DateTime?
  hazards              Hazard[]
  actions              Action[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([organizationId, status])
}

model Hazard {
  id                  String         @id @default(cuid())
  assessmentId        String
  assessment          RiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  /// Gefährdungsfaktor nach GDA-Leitlinie, z. B. "1" = mechanische Gefährdungen
  factor              String
  description         String
  probability         Int
  severity            Int
  measures            String         @default("")
  residualProbability Int?
  residualSeverity    Int?
  sortOrder           Int            @default(0)
  actions             Action[]
  createdAt           DateTime       @default(now())
}

model ChecklistTemplate {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  active         Boolean         @default(true)
  items          ChecklistItem[]
  walkthroughs   Walkthrough[]
  createdAt      DateTime        @default(now())

  @@unique([organizationId, title])
}

model ChecklistItem {
  id         String            @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  section    String
  text       String
  sortOrder  Int               @default(0)
  answers    WalkthroughAnswer[]
}

enum WalkthroughStatus {
  PLANNED
  DONE
}

/// Begehung / Audit
model Walkthrough {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId     String
  template       ChecklistTemplate   @relation(fields: [templateId], references: [id])
  siteId         String?
  site           Site?               @relation(fields: [siteId], references: [id], onDelete: SetNull)
  area           String?
  plannedAt      DateTime
  performedAt    DateTime?
  auditor        String
  participants   String?
  summary        String?
  status         WalkthroughStatus   @default(PLANNED)
  answers        WalkthroughAnswer[]
  actions        Action[]
  createdAt      DateTime            @default(now())

  @@index([organizationId, plannedAt])
}

enum AnswerResult {
  OK
  DEFECT
  NA
}

model WalkthroughAnswer {
  id            String        @id @default(cuid())
  walkthroughId String
  walkthrough   Walkthrough   @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  itemId        String
  item          ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  result        AnswerResult
  note          String?

  @@unique([walkthroughId, itemId])
}

/// PSA-Katalog
model PpeItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       String
  standard       String?
  /// Austausch nach Monaten (Gebrauchsdauer), null = nach Verschleiß
  replaceMonths  Int?
  /// regelmäßige Prüfung erforderlich (z. B. PSA gegen Absturz)
  inspectionRequired Boolean  @default(false)
  active         Boolean      @default(true)
  issues         PpeIssue[]

  @@unique([organizationId, name])
}

/// PSA-Ausgabe mit Empfangsbestätigung
model PpeIssue {
  id         String    @id @default(cuid())
  itemId     String
  item       PpeItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  size       String?
  quantity   Int       @default(1)
  issuedAt   DateTime
  replaceDue DateTime?
  returnedAt DateTime?
  /// Empfang schriftlich bestätigt
  receiptSigned Boolean @default(false)
  createdAt  DateTime  @default(now())

  @@index([employeeId])
}

/// Beauftragte und Pflichtenübertragungen
model Appointment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Schlüssel aus APPOINTMENT_ROLES
  role           String
  siteId         String?
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  /// Aufgabenbereich / übertragene Pflichten
  scope          String?
  appointedAt    DateTime
  validUntil     DateTime?
  /// schriftliche Bestellung / Pflichtenübertragung unterschrieben
  signed         Boolean      @default(false)
  endedAt        DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, role])
}

// ───────────── Phase 7: ASA, Einsatzzeit, Benachrichtigungen ─────────────

enum MeetingStatus {
  PLANNED
  DONE
}

/// Sitzung des Arbeitsschutzausschusses (§ 11 ASiG – mindestens vierteljährlich)
model AsaMeeting {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  date           DateTime
  location       String?
  participants   String?
  agenda         String        @default("")
  minutes        String        @default("")
  status         MeetingStatus @default(PLANNED)
  actions        Action[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, date])
}

/// Einsatzzeit der Fachkraft für Arbeitssicherheit (Tätigkeitsnachweis, DGUV Vorschrift 2)
model TimeEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime
  minutes        Int
  /// Schlüssel aus TIME_CATEGORIES
  category       String
  description    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, date])
}

/// Versandprotokoll für E-Mails (auch ohne SMTP: als Ausgang sichtbar)
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  sent      Boolean
  error     String?
  createdAt DateTime @default(now())
}

// ───────────── Phase 8: Vorsorge, Fremdfirmen, Erlaubnisscheine, Rechtskataster ─────────────

enum MedicalKind {
  /// Pflichtvorsorge (§ 4 ArbMedVV) – ohne sie darf die Tätigkeit nicht ausgeübt werden
  MANDATORY
  /// Angebotsvorsorge (§ 5 ArbMedVV)
  OFFER
  /// Wunschvorsorge (§ 5a ArbMedVV)
  WISH
}

model MedicalCheckType {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  kind           MedicalKind
  /// Anlass nach Anhang ArbMedVV
  reason         String?
  /// Abstand bis zur nächsten Vorsorge in Monaten
  intervalMonths Int                  @default(36)
  active         Boolean              @default(true)
  requirements   MedicalRequirement[]
  records        MedicalRecord[]

  @@unique([organizationId, name])
}

model MedicalRequirement {
  id           String           @id @default(cuid())
  typeId       String
  type         MedicalCheckType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  /// null = alle Beschäftigten
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([typeId, departmentId])
}

enum MedicalOutcome {
  /// Vorsorge durchgeführt (Vorsorgebescheinigung liegt vor)
  DONE
  /// Angebotsvorsorge angeboten, nicht wahrgenommen
  DECLINED
}

/// Vorsorgekartei (§ 3 Abs. 4 ArbMedVV) – ausdrücklich ohne Befunde/Diagnosen
model MedicalRecord {
  id         String           @id @default(cuid())
  typeId     String
  type       MedicalCheckType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  outcome    MedicalOutcome   @default(DONE)
  nextDue    DateTime?
  createdAt  DateTime         @default(now())

  @@index([employeeId, typeId])
}

model Contractor {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  contactName      String?
  phone            String?
  email            String?
  /// Betriebshaftpflicht nachgewiesen bis
  insuranceUntil   DateTime?
  blocked          Boolean            @default(false)
  blockReason      String?
  notes            String?
  workers          ContractorWorker[]
  permits          Permit[]
  createdAt        DateTime           @default(now())

  @@unique([organizationId, name])
}

model ContractorWorker {
  id           String         @id @default(cuid())
  contractorId String
  contractor   Contractor     @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  name         String
  /// Fremdfirmeneinweisung (§ 8 ArbSchG, § 5 DGUV V1)
  briefedAt    DateTime?
  briefedUntil DateTime?
  active       Boolean        @default(true)
  permits      PermitWorker[]
  createdAt    DateTime       @default(now())
}

enum PermitType {
  HOT_WORK
  CONFINED_SPACE
  HEIGHT
  ELECTRICAL
  EXCAVATION
  OTHER
}

enum PermitStatus {
  REQUESTED
  APPROVED
  ACTIVE
  CLOSED
  REJECTED
}

/// Erlaubnisschein für gefährliche Arbeiten
model Permit {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  type           PermitType
  siteId         String?
  site           Site?          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  location       String
  description    String
  contractorId   String?
  contractor     Contractor?    @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  validFrom      DateTime
  validTo        DateTime
  status         PermitStatus   @default(REQUESTED)
  requestedById  String?
  approvedById   String?
  approvedAt     DateTime?
  /// bestätigte Sicherheitsmaßnahmen (Schlüssel der Checkliste)
  checks         String[]
  activatedAt    DateTime?
  closedAt       DateTime?
  /// Brandwache bis (Heißarbeiten)
  fireWatchUntil DateTime?
  note           String?
  workers        PermitWorker[]
  createdAt      DateTime       @default(now())

  @@unique([organizationId, number])
}

model PermitWorker {
  permitId String
  permit   Permit           @relation(fields: [permitId], references: [id], onDelete: Cascade)
  workerId String
  worker   ContractorWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([permitId, workerId])
}

enum ComplianceStatus {
  NOT_EVALUATED
  FULFILLED
  PARTIAL
  NOT_FULFILLED
  NOT_RELEVANT
}

/// Rechtskataster: Vorschrift → Pflicht → Bewertung
model LegalRequirement {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  area           String
  law            String
  reference      String?
  obligation     String
  status         ComplianceStatus @default(NOT_EVALUATED)
  evidence       String?
  responsibleId  String?
  responsible    Employee?        @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  evaluatedAt    DateTime?
  reviewDue      DateTime?
  actions        Action[]
  createdAt      DateTime         @default(now())

  @@index([organizationId, area])
}

// ───────────── Phase 9: Dateien ─────────────

/** Datei-Anhang an einem Datensatz (SDB, Zertifikat, Foto, Prüfbericht …) */
model Attachment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Art des Datensatzes, z. B. SUBSTANCE, EQUIPMENT, INCIDENT
  entityType     String
  entityId       String
  fileName       String
  mimeType       String
  size           Int
  /// Schlüssel im Speicher (lokal oder S3)
  storageKey     String       @unique
  sha256         String
  uploadedById   String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, entityType, entityId])
}

// ───────────── Phase 10: Brandschutz und Notfall ─────────────

/// Alarmplan / Notfallorganisation je Standort (Aushang)
model EmergencyPlan {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId           String       @unique
  site             Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// interne Notrufnummer (z. B. Pforte)
  internalEmergency String?
  fireBrigade      String       @default("112")
  poisonCenter     String?
  doctorOnDuty     String?
  /// Durchgangsarzt / D-Arzt
  dArzt            String?
  assemblyPoint    String
  evacuationHelpers String?
  firstAidRooms    String?
  aedLocations     String?
  alarmSignal      String?
  notes            String?
  reviewedAt       DateTime     @default(now())
  reviewDue        DateTime
  updatedAt        DateTime     @updatedAt
}

enum DrillKind {
  EVACUATION
  FIRE
  FIRST_AID
  OTHER
}

/// Räumungs-, Brandschutz- oder Erste-Hilfe-Übung (ASR A2.3)
model Drill {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId            String
  site              Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  kind              DrillKind    @default(EVACUATION)
  plannedAt         DateTime
  performedAt       DateTime?
  scenario          String?
  /// angekündigt oder unangekündigt
  announced         Boolean      @default(true)
  participants      Int?
  /// Zeit bis zur vollständigen Räumung in Minuten
  evacuationMinutes Int?
  observations      String?
  actions           Action[]
  createdAt         DateTime     @default(now())

  @@index([organizationId, plannedAt])
}

// ───────────── Phase 11: Single Sign-on (OpenID Connect) ─────────────

/// SSO-Konfiguration je Unternehmen (z. B. Microsoft Entra ID, Google Workspace, Keycloak)
model SsoConfig {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// z. B. https://login.microsoftonline.com/<Tenant-ID>/v2.0
  issuer             String
  clientId           String
  /// AES-256-GCM verschlüsselt (Schlüssel: SSO_SECRET_KEY)
  clientSecretEnc    String
  /// E-Mail-Domains, die zu diesem Unternehmen gehören (klein geschrieben)
  emailDomains       String[]
  /// neue Personen beim ersten Login automatisch als Mitarbeiter/in anlegen
  autoProvision      Boolean      @default(false)
  /// Passwort-Anmeldung für diese Domains sperren (nur noch SSO)
  enforce            Boolean      @default(false)
  enabled            Boolean      @default(true)
  updatedAt          DateTime     @updatedAt
}

/// kurzlebiger Zustand einer laufenden SSO-Anmeldung (state, nonce, PKCE)
model SsoState {
  id           String   @id @default(cuid())
  stateHash    String   @unique
  configId     String
  nonce        String
  codeVerifier String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}
