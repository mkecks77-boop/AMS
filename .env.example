# PostgreSQL-Verbindung (Cloud: z. B. gehostete Postgres-Instanz in der EU)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ams"
# Öffentliche Basis-URL der Anwendung (für Einladungslinks)
APP_URL="http://localhost:3000"

# E-Mail-Versand (optional). Ohne SMTP_URL werden Links nur angezeigt.
# SMTP_URL="smtps://benutzer:passwort@smtp.example.com:465"
# MAIL_FROM="AMS <ams@example.com>"
# Geheimnis für den täglichen Lauf POST /api/cron/digest
# CRON_SECRET="lange-zufaellige-zeichenkette"
